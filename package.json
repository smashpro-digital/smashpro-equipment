    "validate": "npm run typecheck && npm test && npm run build && npm run validate:index"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "5.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
